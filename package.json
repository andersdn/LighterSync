{
    "name": "lighter-sync",
    "version": "0.1.1",
    "description": "Lightweight, zero-dependency lip-sync library for browser-based avatar animation. Synchronizes TTS audio with viseme keyframes using script-informed waveform analysis.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "bin": {
        "lighter-sync-dict": "./bin/lighter-sync-dict.mjs"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "slice-dict": "tsx scripts/slice-cmudict.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "lip-sync",
        "viseme",
        "tts",
        "text-to-speech",
        "animation",
        "phoneme",
        "web-audio",
        "avatar"
    ],
    "author": "Anders Najdecki",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/andersdn/LighterSync.git"
    },
    "homepage": "https://github.com/andersdn/LighterSync",
    "bugs": {
        "url": "https://github.com/andersdn/LighterSync/issues"
    },
    "devDependencies": {
        "@types/node": "^25.4.0",
        "tsup": "^8.4.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    },
    "files": [
        "dist",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false
}